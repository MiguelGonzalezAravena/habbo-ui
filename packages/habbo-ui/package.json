{
  "name": "@mgadev/habbo-ui",
  "version": "0.3.0",
  "description": "Historical Habbo-inspired React UI components organized by year",
  "type": "module",
  "sideEffects": [
    "./dist/2006/style.css",
    "./dist/2008/style.css",
    "./dist/2003/style.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./2006": {
      "types": "./dist/2006/index.d.ts",
      "import": "./dist/2006/index.js"
    },
    "./2006/styles.css": "./dist/2006/style.css",
    "./2008": {
      "types": "./dist/2008/index.d.ts",
      "import": "./dist/2008/index.js"
    },
    "./2008/styles.css": "./dist/2008/style.css",
    "./2003": {
      "types": "./dist/2003/index.d.ts",
      "import": "./dist/2003/index.js"
    },
    "./2003/styles.css": "./dist/2003/style.css"
  },
  "scripts": {
    "build": "vite build && vite build --config vite.edition.config.ts --mode 2003 && vite build --config vite.edition.config.ts --mode 2006 && vite build --config vite.edition.config.ts --mode 2008 && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@types/node": "^22.15.0",
    "jsdom": "^26.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^3.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
