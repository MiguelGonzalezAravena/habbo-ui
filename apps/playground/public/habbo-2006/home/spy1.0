<div class="movable widget GuestbookWidget" id="widget-125052" style=" left: 303px; top: 734px; z-index: 38;">
<div class="w_skin_hc_machineskin">
<div class="widget-corner" id="widget-125052-handle">
<div class="widget-headline"><h3><span class="header-left"> </span><span class="header-middle">My Guestbook (<span id="guestbook-size">93</span>)</span><span class="header-right"> </span></h3>
</div>
</div>
<div class="widget-body">
<div class="widget-content">
<div id="guestbook-wrapper">
<ul class="guestbook-entries" id="guestbook-entry-container">
<li class="guestbook-entry" id="guestbook-entry-663506">
<div class="guestbook-author">
<img alt="tappinchick5" src="http://www.habbo.com/habbo-imaging/avatar/5450860001660036960173010114400441af9df1a2372c01f68144d390e660d.gif" title="tappinchick5"/>
</div>
<div class="guestbook-actions">
</div>
