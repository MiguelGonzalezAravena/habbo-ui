ages/common/blue_d.gif\" alt=\"\" width=\"136\" height=\"15\" border=\"0\"></td>\n\t\t<td valign=\"top\"><img src=\"/habbo-2003/habbo/images/common/blue_dr.gif\" alt=\"\" width=\"17\" height=\"15\" border=\"0\"></td>\n\t</tr>\n\t<!-- habbos online box ends -->\n\t</table>",
