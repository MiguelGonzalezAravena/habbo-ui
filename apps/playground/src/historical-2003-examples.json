  "forms": {
    "title": "Formulario de contacto",
    "html": "<div style=\"background:#E59E0F;padding:12px\"><form action=\"/habbo-2003/habbo/en/help/contact/feedback/index.html\" method=\"post\" id=\"theForm\" name=\"theForm\">\n<input type=\"hidden\" name=\"language\" value=\"en\">\n<input type=\"hidden\" name=\"action\" value=\"firstsend\">\n\n<table border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\n<tr>\n\t<td valign=\"top\">What are you writing to us about? *</td>\n\t<td><img src=\"/habbo-2003/habbo/images/blank.gif\" alt=\"\" width=\"7\" height=\"1\" border=\"0\"></td>\n\t<td>\n\n\n\n\n\n<select name=\"type\">\n\t<option value=\"\">Click on the arrows to choose</option>\n\t<option value=\"ban\">Why am I banned?</option>\n\t<option value=\"credits\">Habbo Credits</option>\n\t<option value=\"access\">Having problems checking in</option>\n\t<option value=\"password\">Forgotten my password</option>\n\t<option value=\"magazine\">Article/poem for Habbo Hotel Happenings</option>\n\t<option value=\"dropper\">Habbo Room Dropper request</option>\n\t<option value=\"safety\">HabboHood Watch feedback</option>\n\t<option value=\"idea\">I've got an idea</option>\n\t<option value=\"parent\">I'm a parent</option>\n\t<option value=\"other\">Something else</option>\n</select>\n\n<div id=\"methodMenu\" style=\"display:none\">\n\n<select name=\"method\">\n\t<option value=\"\">How did you buy your credits?</option>\n\t<option value=\"splash\">Splash Plastic</option>\n\t<option value=\"smartcreds\">Smartcreds</option>\n\t<option value=\"landline\">Habbo Credits Line (landline)</option>\n\t<option value=\"sms\">SMS (mobile phone)</option>\n\t<option value=\"credit\">credit or debit card</option>\n\t<option value=\"cheque\">cheque (check) or postal order</option>\n</select>\n</div>\n\n<div id=\"networkMenu\" style=\"display:none\">\n\n<select name=\"network\">\n\t<option value=\"\">Which mobile network are you on?</option>\n\t<option value=\"vodafone\">Vodafone</option>\n\t<option value=\"o2\">O2</option>\n\t<option value=\"orange\">Orange</option>\n\t<option value=\"tmobile\">T-Mobile</option>\n</select>\n</div>\n\n<div id=\"mobilephoneDiv\" style=\"display:none\">\nPlease tell us your mobile phone number:<br>\n\n<input type=\"text\" name=\"mobilephone\" size=\"40\" value=\"\">\n</div>\n\n<div id=\"homephoneDiv\" style=\"display:none\">\nPlease tell us your home phone number:<br>\n\n<input type=\"text\" name=\"homephone\" size=\"40\" value=\"\">\n</div>\n\n\n\n\t</td>\n</tr>\n</table>\n\n<table border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\n<tr>\n\t<td><img src=\"/habbo-2003/habbo/images/blank.gif\" alt=\"\" width=\"1\" height=\"4\" border=\"0\"></td>\n</tr>\n<tr>\n\t<td>What's your email address? *</td>\n\t<td><img src=\"/habbo-2003/habbo/images/blank.gif\" alt=\"\" width=\"7\" height=\"1\" border=\"0\"></td>\n\t<td>\n\n<input type=\"text\" name=\"email\" size=\"40\" value=\"\">\n\t</td>\n</tr>\n<tr>\n\t<td><img src=\"/habbo-2003/habbo/images/blank.gif\" alt=\"\" width=\"1\" height=\"4\" border=\"0\"></td>\n</tr>\n<tr>\n\t<td>What's your Habbo called?</td>\n\t<td><img src=\"/habbo-2003/habbo/images/blank.gif\" alt=\"\" width=\"7\" height=\"1\" border=\"0\"></td>\n\t<td>\n\n<input type=\"text\" name=\"habboname\" size=\"40\" value=\"\">\n\t</td>\n</tr>\n<tr>\n\t<td><img src=\"/habbo-2003/habbo/images/blank.gif\" alt=\"\" width=\"1\" height=\"4\" border=\"0\"></td>\n</tr>\n<tr>\n\t<td valign=\"top\">Type your message here: *</td>\n\t<td><img src=\"/habbo-2003/habbo/images/blank.gif\" alt=\"\" width=\"7\" height=\"1\" border=\"0\"></td>\n\t<td>\n\n<textarea name=\"message\" rows=\"8\" cols=\"40\"></textarea>\n\t</td>\n</tr>\n<tr>\n\t<td class=\"bgContentRuler\"><img src=\"/habbo-2003/habbo/images/blank.gif\" alt=\"\" width=\"1\" height=\"22\" border=\"0\"></td>\n\t<td class=\"bgContentRuler\"><img src=\"/habbo-2003/habbo/images/blank.gif\" alt=\"\" width=\"7\" height=\"22\" border=\"0\"></td>\n\t<td class=\"bgContentRuler\"><img src=\"/habbo-2003/habbo/images/blank.gif\" alt=\"\" width=\"1\" height=\"22\" border=\"0\"></td>\n</tr>\n<tr>\n\t<td colspan=\"3\" align=\"right\"><input type=\"submit\" value=\"Submit\"></td>\n</tr>\n</table>\n\n</form></div>",
    "width": 503,
    "description": "Formulario recuperado de la página de contacto: controles HTML nativos bajo el CSS de 2003. Los campos se pueden probar, pero no se envían datos. Los apartados que requerían scripts originales siguen sin conexión.",
    "source": "habbo/en/help/contact/feedback/index.html",
    "src": "/habbo-2003/components/forms.html"
  },
  "select": {
    "title": "Selector de semana",
